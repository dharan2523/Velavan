{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "VelavanDemo.Api",
    "Audience": "VelavanDemo.Web",
    "AccessTokenMinutes": 60
  },
  "Branding": {
    "DisplayName": "Velavan Demo",
    "ShortName": "Velavan",
    "LogoUrl": ""
  },
  "Attachments": {
    "Storage": {
      "Provider": "Local",
      "RootPath": "C:\\ProgramData\\VelavanDemo\\attachments",
      "MaxTotalBytes": 0,
      "ServiceAccount": ""
    },
    "Scanner": {
      "Provider": "None",
      "Endpoint": "",
      "ApiKey": "",
      "TimeoutSeconds": 30
    },
    "Reconciliation": {
      "Enabled": false,
      "RunOnStartup": false,
      "IntervalMinutes": 1440,
      "OrphanGracePeriodMinutes": 30
    }
  }
}
